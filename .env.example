SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USERNAME=your-email@gmail.com (mail dùng để gửi recovery email)

SMTP_PASSWORD=your-google-app-password (https://myaccount.google.com/apppasswords)

SMTP_FROM=your-email@gmail.com (mail dùng để gửi recovery email)

APP_BASE_URL=http://127.0.0.1:8000

SESSION_SECRET=generate-your-own-random-secret (chạy lệnh py -c "import secrets; print(secrets.token_urlsafe(32))" )